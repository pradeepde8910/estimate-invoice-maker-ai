            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample QA Technologies Pvt Ltd\",\n  \"tagline\": \"Synthetic QA Test Data\",\n  \"address\": \"1 Test Street, QA District, Sample City - 000000\",\n  \"email\": \"qa-sample@example-testing.invalid\",\n  \"phone\": \"9000000000\",\n  \"website\": \"https://example-testing.invalid\",\n  \"gstin\": \"22AAAAA0000A1Z5\",\n  \"registration_number\": \"QA-SAMPLE-0001\",\n  \"bank_name\": \"Sample Test Bank\",\n  \"bank_account_number\": \"0000000000000000\",\n  \"bank_ifsc\": \"TEST0000001\",\n  \"bank_branch\": \"QA Branch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
