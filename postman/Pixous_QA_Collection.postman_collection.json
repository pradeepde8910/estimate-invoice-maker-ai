    {
      "name": "Jobs (AI Pipeline)",
      "description": "Exercises the full AI pipeline. Unlike the automated test suite (which mocks the LangGraph pipeline), these requests call the real Mistral/Groq/Gemini APIs configured in the server's .env and may take 1-3 minutes to complete.",
      "item": [
        {
          "name": "Create Job (Text)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/jobs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "description": "Submits a synthetic project brief as raw text. Captures job_id.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "text",
                  "value": "Build a customer loyalty rewards web application for a mid-size retail chain (sample/synthetic brief for QA testing). Customers earn points per purchase, redeem them for discounts, and view their point balance and history in a self-service portal. Admin staff need a dashboard to configure earn/redeem rates and view program analytics.",
                  "type": "text"
                },
                {
                  "key": "generate_brd",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "generate_srs",
                  "value": "true",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job created\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"job_id\", pm.response.json().job_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/jobs/{{job_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait For Job (blocking)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/jobs/{{job_id}}/wait?timeout=120",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "wait"
              ],
              "query": [
                {
                  "key": "timeout",
                  "value": "120"
                }
              ]
            },
            "description": "Blocks server-side until the job finishes or the timeout elapses - convenient for JMeter/k6 scripts that prefer one request over a polling loop.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
