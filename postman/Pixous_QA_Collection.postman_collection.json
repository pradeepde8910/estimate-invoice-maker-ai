            ],
            "url": {
              "raw": "{{base_url}}/api/estimations/{{base_name}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "estimations",
                "{{base_name}}"
              ]
            },
            "description": "Admin-only. Optimistic-locked - version must match the estimation's current version or this 409s.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"QA Sample Payroll Migration (Revised)\",\n  \"version\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 for Admin, 403 for non-Admin, 409 on version conflict\", function () {",
                  "    pm.expect([200, 403, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Estimation (Admin-only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/estimations/{{base_name}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "estimations",
                "{{base_name}}"
              ]
            },
            "description": "Soft-deletes the estimation created above. Run this LAST in the folder - it hides the estimation from subsequent Invoice requests in this collection.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 for Admin, 403 for non-Admin\", function () {",
                  "    pm.expect([200, 403, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
