# === API KEYS ===
# Mistral OCR — https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq LLM (comma-separated for key rotation) — https://console.groq.com/keys
GROQ_API_KEYS=key1,key2,key3

# Gemini Web Search (comma-separated for key rotation) — https://aistudio.google.com/
GEMINI_API_KEYS=key1,key2,key3

# === AUTHENTICATION ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=pixous-super-secret-key-12345

# QA/staging only - leave QA_TEST_API_KEY unset (blank) in production.
# Any request with a matching X-API-Key header authenticates as
# QA_TEST_USERNAME (defaults to ADMIN_USERNAME) instead of a Bearer token -
# it still goes through normal role checks as that identity, so give
# QA_TEST_USERNAME a Developer-role account instead if you want the key to
# exercise non-Admin paths.
QA_TEST_API_KEY=your_qa_test_api_key_here
QA_TEST_USERNAME=admin
# === DATABASE ===
# Local dev default (SQLite file, no setup needed):
# DATABASE_URL=sqlite:///pixous.db
# Production (PostgreSQL) — DevOps supplies this:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=sqlite:///pixous.db

